{
  "manifest_version": 2,
  "name": "Your Extension Name",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "#/*"  // Replace with the target website URL
      ],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "#/*"  // Replace with the target website URL
  ],
  "browser_action": {
    "default_popup": "popup.html"
  }
}
